<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\RiscVEmulator.Core.csproj" />
    <ProjectReference Include="..\..\Frontend\RiscVEmulator.Frontend.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Examples.Quake</RootNamespace>
  </PropertyGroup>

  <!-- Bare-metal platform shim + linker script + Quake config header. The
       full TyrQuake source lives in tyrquake/ (vendored via git) and is
       picked up by Program.cs from a relative path; not copied. -->
  <ItemGroup>
    <None Update="Programs\quake_main.c"    CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\vid_rvemu.c"     CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\snd_rvemu.c"     CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\in_rvemu.c"      CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\sys_rvemu.c"     CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\stubs_rvemu.c"   CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\rvemu_config.h"  CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\setjmp.h"        CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\dirent.h"        CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\sys\stat.h"      CopyToOutputDirectory="PreserveNewest" />
    <None Update="Programs\sys\types.h"     CopyToOutputDirectory="PreserveNewest" />
    <!-- Optional: drop the freely-redistributable shareware pak0.pak next
         to the built exe (Examples/Quake/bin/.../net10.0/id1/pak0.pak).
         Program.cs streams it from disk via DiskDevice. -->
  </ItemGroup>

</Project>
