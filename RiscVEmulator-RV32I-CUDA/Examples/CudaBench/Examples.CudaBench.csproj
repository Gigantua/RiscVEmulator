<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\RiscVEmulator.Core.csproj" />
    <ProjectReference Include="..\..\Native\rv32i_cuda.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Examples.CudaBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\Native\bin\Release\rv32i_cuda.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>rv32i_cuda.dll</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
