<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\RiscVEmulator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Device trees for the MMU (Sv32) and RV64GC boot paths — read at runtime. -->
    <Content Include="rvemu-mmu.dtb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="rvemu-mmu-gui.dtb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="rvemu-rv64.dtb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Examples.Linux</RootNamespace>
  </PropertyGroup>

</Project>
